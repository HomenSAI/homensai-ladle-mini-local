FROM node:22.11.0-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 python3-venv openjdk-17-jdk-headless chromium \
    && rm -rf /var/lib/apt/lists/*
RUN python3 -m venv /opt/check-venv \
    && /opt/check-venv/bin/pip install --no-cache-dir playwright==1.55.0 Pillow==11.3.0
ENV PATH="/opt/check-venv/bin:${PATH}" PYTHONUTF8=1
WORKDIR /workspace
CMD ["bash", "tools/check-all.sh"]
